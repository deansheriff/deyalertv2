# Copy to .env for local overrides. Never commit real values.
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/deyalert
REDIS_URL=redis://localhost:63790/0
# Base of SOS tracking and consent links. Must be https in production.
PUBLIC_BASE_URL=http://127.0.0.1:8010

SUPABASE_URL=
# Hosted Supabase: set the JWKS URL. Self-hosted: set JWT_SECRET from the Supabase service instead.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SMS_HOOK_SECRET=

# Contents of the Firebase service account JSON, on one line
FCM_SERVICE_ACCOUNT_JSON=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://v3.api.termii.com
SENTRY_DSN=

# At least 32 random characters in production
ADMIN_SESSION_SECRET=

CORROBORATION_RADIUS_M=2000
CORROBORATION_THRESHOLD=3
FLAG_HIDE_THRESHOLD=5.0
# Leave empty to use incident_types.ttl_minutes
TTL_OVERRIDE_MINUTES=
OTP_DAILY_CAP=2000
SMS_DAILY_CAP=2000
SMS_FALLBACK_ENABLED=false
